{
  "Platform": {
    "ProductName": "Scholar Suite"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Auth": {
    "Issuer": "scholar-suite",
    "Audience": "scholar-suite",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14,
    "SessionMaxDays": 30,
    "SecureCookies": true,
    "PublicAppUrl": "http://localhost:3000"
  },
  "RateLimits": {
    "AuthPerMinute": 10,
    "PublicPerMinute": 20
  }
}
